{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "payment_reminder_automation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processPaymentReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Process payment reminders",
            "description": "Sweep invoices and send due reminders"
          }
        }
      }
    ]
  },
  "description": "Hourly sweep that evaluates invoices with reminders enabled and sends payment reminder emails to clients with outstanding balances.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Payment Reminder Automation"
}