{
  "name": "FanSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Subscriber email address (unique per fan)"
    },
    "name": {
      "type": "string",
      "description": "Optional fan-provided name"
    },
    "source_slug": {
      "type": "string",
      "description": "Where the signup came from \u2014 a release slug or 'newsletter'"
    },
    "utm_source": {
      "type": "string",
      "description": "Raw utm_source parameter captured at signup"
    },
    "utm_medium": {
      "type": "string",
      "description": "Raw utm_medium parameter captured at signup"
    },
    "utm_campaign": {
      "type": "string",
      "description": "Raw utm_campaign parameter captured at signup"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "unsubscribed"
      ],
      "default": "active",
      "description": "Subscription status \u2014 'active' receives emails, 'unsubscribed' opted out"
    },
    "signup_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the fan subscribed"
    },
    "consent_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp proving the fan consented to receive email updates (auto-set on create)"
    },
    "welcome_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the welcome email was successfully sent to this fan. Set once; used so a re-signup on another page still gets the welcome email if the first send never happened."
    },
    "description": {
      "type": "string",
      "description": "Optional description for this fan subscriber",
      "maxLength": 1000
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}