{
  "name": "BrandProfile",
  "type": "object",
  "properties": {
    "agent_avatar_url": {
      "type": "string",
      "description": "Optional picture for Jade, the marketing agent. When set it replaces her built-in illustrated avatar in the post panel."
    },

    "studio_name": {
      "type": "string",
      "default": "iRoxanne Studio",
      "description": "Studio name used in generated copy \u2014 always spelled exactly this way"
    },
    "voice_description": {
      "type": "string",
      "description": "How the studio speaks to its audience (tone, register)"
    },
    "service_description": {
      "type": "string",
      "description": "What the studio builds and for whom (service description)"
    },
    "audience_description": {
      "type": "string",
      "description": "Who the audience is (small business owners, solo founders, creators)"
    },
    "positioning_notes": {
      "type": "string",
      "description": "Positioning notes \u2014 when/how to emphasize the personal, real-person, not-an-agency angle"
    },
    "writing_rules": {
      "type": "string",
      "default": "No long em dashes\nNo corporate marketing speak\nWarm, conversational, direct\nNever invent client names, testimonials, or results",
      "description": "Hard rules, one per line \u2014 override any generic content rules where they conflict"
    },
    "banned_words_phrases": {
      "type": "string",
      "description": "Words or phrases the AI must never use"
    },
    "example_captions": {
      "type": "string",
      "description": "Captions the admin loves, for style reference"
    },
    "default_links": {
      "type": "string",
      "description": "Default links the AI can reference (portfolio URL, consult-booking URL, etc.)"
    },
    "hashtag_bank": {
      "type": "string",
      "description": "Preferred hashtags by platform (e.g. #NoCode #Base44 #CustomApps #SmallBusinessTools #SoloFounder)"
    },
    "posts_per_campaign_week": {
      "type": "number",
      "default": 4,
      "description": "How many posts the daily auto-generator keeps filled in the coming 7 days for each Active campaign."
    },
    "posts_per_evergreen_week": {
      "type": "number",
      "default": 3,
      "description": "How many posts the daily auto-generator keeps rotating per week for each featured portfolio item on evergreen rotation."
    },
    "mix_loop_pct": {
      "type": "number",
      "default": 40,
      "description": "Target share (%) of portfolio/showcase posts in the generated content mix."
    },
    "mix_authentic_pct": {
      "type": "number",
      "default": 30,
      "description": "Target share (%) of educational/tech-tip posts in the generated content mix."
    },
    "mix_cta_pct": {
      "type": "number",
      "default": 20,
      "description": "Target share (%) of testimonial/social-proof posts in the generated content mix."
    },
    "instagram_profile_url": {
      "type": "string",
      "description": "Public Instagram profile URL (https). A profile link is NOT an authenticated publishing connection."
    },
    "facebook_page_url": {
      "type": "string",
      "description": "Public Facebook Page URL (https). A profile link is NOT an authenticated publishing connection."
    },
    "tiktok_profile_url": {
      "type": "string",
      "description": "Public TikTok profile URL (https). Used only for the manual-sharing workflow \u2014 TikTok has no publishing integration."
    },
    "youtube_channel_url": {
      "type": "string",
      "description": "Public YouTube channel URL (https). Used only for the manual-sharing workflow \u2014 YouTube has no publishing integration."
    },
    "image_style_notes": {
      "type": "string",
      "default": "No text or logos baked into the image. Show real screenshots/UI where possible. Branding added separately.",
      "description": "Rules for AI image prompts"
    },
    "image_style_presets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Preset name"
          },
          "prompt_suffix": {
            "type": "string",
            "description": "Appended to an image prompt when this preset is selected"
          }
        },
        "required": [
          "name",
          "prompt_suffix"
        ]
      },
      "description": "Reusable image style presets \u2014 appended to image prompts for a consistent look"
    },
    "notify_email": {
      "type": "string",
      "description": "Email address to send reminder/digest emails to (the admin's account email)"
    },
    "notify_timezone": {
      "type": "string",
      "default": "America/New_York",
      "description": "IANA timezone for the admin (e.g. America/New_York). Scheduled reminder functions compute 'today' and the current time window in this zone so nudges fire at the right local time."
    },
    "notify_daily_posts": {
      "type": "boolean",
      "default": true,
      "description": "Send a daily email + push when posts are due"
    },
    "notify_weekly_digest": {
      "type": "boolean",
      "default": true,
      "description": "Send a weekly digest email (Sunday evening)"
    },
    "notify_launch_countdown": {
      "type": "boolean",
      "default": false,
      "description": "Send launch-countdown emails (14/7/3/1 days before a campaign launch date)."
    },
    "notify_filming_nudge": {
      "type": "boolean",
      "default": true,
      "description": "Send a monthly content nudge email with shot/screen briefs"
    },
    "notify_send_time": {
      "type": "string",
      "default": "08:00",
      "description": "Local time (HH:MM) to send the daily posts-due email"
    },
    "description": {
      "type": "string",
      "description": "Optional description for this brand profile",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}