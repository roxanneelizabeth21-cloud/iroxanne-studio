{
  "name": "PricingSettings",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description for these pricing settings",
      "maxLength": 1000
    },
    "rate_per_hour": {
      "type": "number",
      "default": 65,
      "description": "Blended $/hr used by the quote estimator and proposal builder"
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "custom_quote",
        "fixed_packages",
        "packages_addons"
      ],
      "default": "packages_addons",
      "description": "How pricing is presented to clients. custom_quote = write a price per project; fixed_packages = set tiers; packages_addons = tiers plus selectable add-ons."
    },
    "packages": {
      "type": "array",
      "description": "Service packages / tiers shown when pricing_mode is fixed_packages or packages_addons",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Package name e.g. Starter"
          },
          "price": {
            "type": "number",
            "description": "Fixed price (USD)"
          },
          "description": {
            "type": "string",
            "description": "What's included"
          },
          "highlight": {
            "type": "boolean",
            "default": false,
            "description": "Whether this package is highlighted/recommended"
          }
        },
        "required": [
          "name",
          "price"
        ]
      }
    },
    "addons": {
      "type": "array",
      "description": "Optional add-ons selectable on top of a package (packages_addons mode)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "price"
        ]
      }
    },
    "default_deposit_percent": {
      "type": "number",
      "default": 50,
      "description": "Deposit percentage applied to new contracts (e.g. 50 = 50% upfront, 50% on launch)"
    },
    "standard_terms": {
      "type": "string",
      "description": "Default terms & conditions text pre-filled on new contracts",
      "maxLength": 40000
    },
    "stripe_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether Stripe checkout is wired up for deposit collection. Until true, deposits are marked pay-offline."
    },
    "payment_link": {
      "type": "string",
      "description": "A hosted pay-online link (Stripe Payment Link, Square checkout, PayPal.me). Added as a 'Pay online' button on invoice emails when set."
    },
    "payment_instructions": {
      "type": "string",
      "maxLength": 2000,
      "description": "How clients can pay you \u2014 Zelle/CashApp handle, Square note, bank transfer details. Shown on invoice emails and the client payment page. Line breaks are preserved."
    },
    "invoice_due_days": {
      "type": "number",
      "default": 7,
      "description": "Default number of days a client has to pay an invoice after it's sent"
    },
    "proposal_valid_days": {
      "type": "number",
      "default": 3,
      "description": "Default number of days a new proposal stays valid"
    },
    "rush_terms": {
      "type": "string",
      "maxLength": 8000
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}