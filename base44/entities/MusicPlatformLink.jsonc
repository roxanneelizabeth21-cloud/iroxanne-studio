{
  "name": "MusicPlatformLink",
  "type": "object",
  "properties": {
    "release_id": {
      "type": "string",
      "description": "ID of the MusicRelease this link belongs to"
    },
    "platform_name": {
      "type": "string",
      "description": "Human-readable platform name"
    },
    "platform_type": {
      "type": "string",
      "enum": [
        "spotify",
        "apple_music",
        "youtube",
        "amazon_music",
        "tidal",
        "pandora",
        "iheartradio",
        "deezer",
        "itunes",
        "tiktok_instagram",
        "other"
      ],
      "default": "other",
      "description": "Platform type identifier"
    },
    "display_label": {
      "type": "string",
      "description": "Button label, e.g. Listen on Spotify"
    },
    "url": {
      "type": "string",
      "description": "Platform URL (leave blank to hide)"
    },
    "is_visible": {
      "type": "boolean",
      "default": false,
      "description": "Whether this platform button is shown publicly"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower shows first)"
    },
    "icon_name": {
      "type": "string",
      "description": "lucide-react icon name for this platform"
    },
    "opens_in_new_tab": {
      "type": "boolean",
      "default": true,
      "description": "Whether the link opens in a new tab"
    },
    "description": {
      "type": "string",
      "description": "Optional description for this platform link",
      "maxLength": 1000
    }
  },
  "required": [
    "release_id",
    "platform_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_visible": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}