{
  "name": "Contract",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description for this contract",
      "maxLength": 1000
    },
    "lead_id": {
      "type": "string",
      "description": "Lead this contract was generated from (optional)"
    },
    "client_name": {
      "type": "string",
      "description": "Client / signer name"
    },
    "client_email": {
      "type": "string",
      "description": "Client email \u2014 where the contract link is sent"
    },
    "project_title": {
      "type": "string",
      "description": "Project / app name"
    },
    "scope_summary": {
      "type": "string",
      "description": "Plain-language description of what will be built / delivered",
      "maxLength": 4000
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "custom_quote",
        "fixed_packages",
        "packages_addons"
      ],
      "default": "custom_quote",
      "description": "How the price on this contract was determined"
    },
    "selected_package": {
      "type": "string",
      "description": "Name of the package selected, when pricing_mode is a package mode"
    },
    "line_items": {
      "type": "array",
      "description": "Itemized pricing lines (custom quotes and add-ons)",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "description",
          "amount"
        ]
      }
    },
    "price_total": {
      "type": "number",
      "description": "Total contract price (USD)"
    },
    "deposit_percent": {
      "type": "number",
      "default": 50,
      "description": "Deposit percentage applied to this contract (e.g. 50 = 50%)"
    },
    "deposit_amount": {
      "type": "number",
      "description": "Deposit due at signing (USD)"
    },
    "payment_schedule": {
      "type": "string",
      "description": "Agreed payment schedule e.g. 50% upfront, 50% on launch"
    },
    "terms": {
      "type": "string",
      "description": "Terms & conditions text the client agrees to",
      "maxLength": 8000
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "signed",
        "deposit_paid",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Contract lifecycle status"
    },
    "access_token": {
      "type": "string",
      "description": "Unguessable token required to view/sign the contract via the public client page. Generated on send."
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer_name": {
      "type": "string",
      "description": "Typed name used as the e-signature"
    },
    "signer_ip": {
      "type": "string",
      "description": "IP captured at signing for audit"
    },
    "estimated_tier": {
      "type": "string",
      "description": "Project tier carried over from the Lead estimate (starter/business/custom)"
    },
    "stripe_checkout_url": {
      "type": "string",
      "description": "Stripe Checkout session URL for the deposit (set when Stripe is wired)"
    },
    "stripe_payment_intent": {
      "type": "string",
      "description": "Stripe Payment Intent id for the deposit"
    },
    "deposit_paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_consent": {
      "type": "boolean"
    },
    "signer_user_agent": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_mode": {
      "type": "string",
      "enum": [
        "typed",
        "drawn"
      ],
      "default": "typed"
    },
    "signature_image": {
      "type": "string",
      "maxLength": 180000
    },
    "target_launch_date": {
      "type": "string",
      "format": "date"
    },
    "contract_variant": {
      "type": "string",
      "enum": [
        "standard",
        "rush"
      ],
      "default": "standard"
    },
    "rush_terms": {
      "type": "string",
      "maxLength": 8000
    },
    "handoff_status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "accepted",
        "changes_requested"
      ],
      "default": "draft"
    },
    "handoff_token": {
      "type": "string"
    },
    "handoff_internal_notes": {
      "type": "string",
      "maxLength": 5000
    },
    "handoff_client_notes": {
      "type": "string",
      "maxLength": 3000
    },
    "handoff_ack_name": {
      "type": "string"
    },
    "handoff_ack_at": {
      "type": "string",
      "format": "date-time"
    },
    "handoff_ack_ip": {
      "type": "string"
    },
    "handoff_ack_user_agent": {
      "type": "string"
    },
    "handoff_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "completed": {
            "type": "boolean"
          },
          "completed_at": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "client_email",
    "project_title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}