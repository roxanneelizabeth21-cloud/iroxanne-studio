{
  "name": "Lead",
  "type": "object",
  "properties": {
    "selected_package": {
      "type": "string",
      "description": "Requested service; not an accepted purchase."
    },
    "description": {
      "type": "string",
      "description": "Optional description for this lead",
      "maxLength": 1000
    },
    "email": {
      "type": "string",
      "description": "Lead email address"
    },
    "name": {
      "type": "string",
      "description": "Lead contact name"
    },
    "interested_apps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "App/service categories the lead is interested in"
    },
    "source": {
      "type": "string",
      "description": "Where the lead came from (e.g. get_quote_form)"
    },
    "request_type": {
      "type": "string",
      "description": "Kind of request (e.g. quote_request)"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "proposal_sent",
        "won",
        "lost",
        "archived"
      ],
      "default": "new",
      "description": "Lead lifecycle status"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "business_name": {
      "type": "string",
      "description": "Business name"
    },
    "business_type": {
      "type": "string",
      "description": "Business type / industry"
    },
    "website": {
      "type": "string",
      "description": "Existing website URL, if any"
    },
    "quick_pitch": {
      "type": "string",
      "description": "2-3 sentence summary of what the client needs built"
    },
    "problem_to_solve": {
      "type": "string",
      "description": "Problem or pain point driving the project"
    },
    "must_have_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Features required for launch"
    },
    "nice_to_have_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Features that are fine to add later"
    },
    "existing_tools": {
      "type": "string",
      "description": "Tools currently in use and any pain points"
    },
    "integrations_needed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Integrations the lead will need"
    },
    "design_style": {
      "type": "string",
      "description": "Preferred design style"
    },
    "design_inspiration": {
      "type": "string",
      "description": "Links to sites/apps the lead likes"
    },
    "ideal_launch_date": {
      "type": "string",
      "description": "Ideal launch date or timeframe"
    },
    "ongoing_support_needed": {
      "type": "boolean",
      "default": false,
      "description": "Whether ongoing post-launch support is wanted"
    },
    "budget_range": {
      "type": "string",
      "enum": [
        "under_1500",
        "1500_3000",
        "3000_5000",
        "5000_8000",
        "8000_plus",
        "not_sure"
      ],
      "description": "Selected budget range"
    },
    "estimated_tier": {
      "type": "string",
      "description": "Auto-estimated project tier (starter, business, custom)"
    },
    "estimated_hours_low": {
      "type": "number",
      "description": "Auto-estimated lower bound of hours"
    },
    "estimated_hours_high": {
      "type": "number",
      "description": "Auto-estimated upper bound of hours"
    },
    "estimated_price_low": {
      "type": "number",
      "description": "Auto-estimated lower bound of price (USD)"
    },
    "estimated_price_high": {
      "type": "number",
      "description": "Auto-estimated upper bound of price (USD)"
    },
    "booking_token": {
      "type": "string"
    },
    "call_event_id": {
      "type": "string"
    },
    "call_start": {
      "type": "string"
    },
    "call_end": {
      "type": "string"
    },
    "call_pending_start": {
      "type": "string"
    },
    "email_verified_at": {
      "type": "string"
    },
    "email_verification_id": {
      "type": "string"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}