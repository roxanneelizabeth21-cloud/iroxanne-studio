{
  "name": "CanvaAuth",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "description": "Random state value for this Canva connect attempt (CSRF protection)"
    },
    "code_verifier": {
      "type": "string",
      "description": "PKCE code verifier generated when the connect flow started"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "connected",
        "failed"
      ],
      "default": "pending",
      "description": "Connection state of this attempt"
    },
    "access_token": {
      "type": "string",
      "description": "Canva access token"
    },
    "refresh_token": {
      "type": "string",
      "description": "Canva refresh token used to renew the access token"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the access token expires"
    },
    "error": {
      "type": "string",
      "description": "Last error returned by Canva, when the attempt failed"
    },
    "description": {
      "type": "string",
      "description": "Optional note about this Canva connection",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}