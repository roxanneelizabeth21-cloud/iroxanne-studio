{
  "name": "ArtistProfileLink",
  "type": "object",
  "properties": {
    "platform_name": {
      "type": "string",
      "description": "Display name shown on the button (e.g. Spotify, Apple Music)"
    },
    "platform_type": {
      "type": "string",
      "enum": [
        "spotify",
        "apple_music",
        "youtube",
        "amazon_music",
        "tidal",
        "pandora",
        "iheartradio",
        "tiktok_instagram",
        "instagram",
        "facebook",
        "other"
      ],
      "default": "other",
      "description": "Platform type identifier (drives the default icon)"
    },
    "url": {
      "type": "string",
      "description": "Artist profile URL on this platform"
    },
    "display_label": {
      "type": "string",
      "description": "Button label, e.g. Follow on Spotify"
    },
    "icon_name": {
      "type": "string",
      "description": "lucide-react icon name for this platform"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether this artist profile button is shown publicly"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower shows first)"
    },
    "description": {
      "type": "string",
      "description": "Optional description for this artist profile link",
      "maxLength": 1000
    }
  },
  "required": [
    "platform_name",
    "url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}