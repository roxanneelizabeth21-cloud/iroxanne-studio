{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Track title"
    },
    "audio_file": {
      "type": "string",
      "description": "Audio file URL for this track"
    },
    "lyrics": {
      "type": "string",
      "description": "Full lyrics for this track"
    },
    "track_number": {
      "type": "number",
      "default": 1,
      "description": "Order of the track within the album"
    },
    "duration": {
      "type": "number",
      "description": "Track duration in seconds"
    },
    "release_id": {
      "type": "string",
      "description": "ID of parent MusicRelease"
    },
    "snippet_start": {
      "type": "number",
      "description": "Snippet preview start time in seconds"
    },
    "snippet_end": {
      "type": "number",
      "description": "Snippet preview end time in seconds"
    },
    "snippet_duration": {
      "type": "number",
      "description": "Snippet preview duration in seconds"
    },
    "description": {
      "type": "string",
      "description": "Optional description for this track",
      "maxLength": 1000
    }
  },
  "required": [
    "title",
    "release_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}