{
  "name": "MarketingPost",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description for this marketing post",
      "maxLength": 1000
    },
    "campaign_id": {
      "type": "string",
      "description": "ID of the Campaign this post belongs to (optional \u2014 posts can be standalone)"
    },
    "portfolio_item_id": {
      "type": "string",
      "description": "ID of the PortfolioItem this post showcases/promotes (optional)"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Facebook",
        "Instagram",
        "YouTube",
        "TikTok"
      ],
      "description": "Primary target social platform"
    },
    "publish_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Facebook",
          "Instagram"
        ]
      },
      "description": "Platforms selected for direct publishing. Only Instagram and Facebook can publish directly (Meta). TikTok and YouTube are manual-sharing destinations and never appear here."
    },
    "link_target": {
      "type": "string",
      "enum": [
        "Portfolio page",
        "Consult booking",
        "Get a Quote",
        "None"
      ],
      "description": "Which link is appended at the bottom of the post. Defaults to the portfolio page when a PortfolioItem is attached, Get a Quote for service posts, otherwise the consult-booking link."
    },
    "format": {
      "type": "string",
      "enum": [
        "Feed Post",
        "Reel",
        "Story",
        "Short",
        "Video",
        "Community Post"
      ],
      "description": "Post format"
    },
    "content_bucket": {
      "type": "string",
      "enum": [
        "Loop Clip",
        "Authentic/Personal",
        "Announcement/CTA",
        "Service Offer",
        "Pain Point / Education",
        "Behind the Build",
        "Social Proof"
      ],
      "description": "Content category the AI assigned \u2014 drives content strategy and clip-matching rules"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Date the post is scheduled to go live. Acts as the fallback for any platform without its own date."
    },
    "scheduled_time": {
      "type": "string",
      "description": "Scheduled time (HH:MM), optional. Reminders default to 9:00 AM when unset. Acts as the fallback for any platform without its own time."
    },
    "instagram_scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Instagram-specific publish date. Blank falls back to scheduled_date, so Instagram can be staggered away from Facebook."
    },
    "instagram_scheduled_time": {
      "type": "string",
      "description": "Instagram-specific publish time (HH:MM). Blank falls back to scheduled_time."
    },
    "facebook_scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Facebook-specific publish date. Blank falls back to scheduled_date."
    },
    "facebook_scheduled_time": {
      "type": "string",
      "description": "Facebook-specific publish time (HH:MM). Blank falls back to scheduled_time."
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Pending Review",
        "Approved",
        "Ready",
        "Scheduled",
        "Publishing",
        "Posted",
        "Partially Published",
        "Failed",
        "Paused",
        "Cancelled",
        "Skipped"
      ],
      "default": "Draft",
      "description": "Post lifecycle status"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Pending Review",
        "Approved"
      ],
      "default": "Draft",
      "description": "Approval workflow gate. Posts must be Approved before they can be scheduled or published."
    },
    "publish_mode": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ],
      "default": "manual",
      "description": "When auto the system will attempt direct posting when the scheduled time arrives."
    },
    "publishing_status": {
      "type": "string",
      "description": "Overall publishing operation state (Publishing, Published, Partially Published, Failed)"
    },
    "last_publish_attempt_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last publish attempt started"
    },
    "external_post_id": {
      "type": "string",
      "description": "External post ID from the first platform that published successfully"
    },
    "posted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the post was published to at least one platform"
    },
    "caption": {
      "type": "string",
      "description": "Post caption / body text",
      "maxLength": 4000
    },
    "hashtags": {
      "type": "string",
      "description": "Hashtags to append to the caption (stored separately for easy editing)",
      "maxLength": 500
    },
    "hook": {
      "type": "string",
      "description": "Opening hook line \u2014 the scroll-stopper",
      "maxLength": 300
    },
    "cta": {
      "type": "string",
      "description": "Call-to-action line",
      "maxLength": 300
    },
    "image_prompt": {
      "type": "string",
      "description": "AI image generation prompt (used by generateMarketingImage)",
      "maxLength": 1000
    },
    "image_style_preset": {
      "type": "string",
      "description": "Name of the Brand Profile style preset to apply to the image prompt"
    },
    "media_url": {
      "type": "string",
      "description": "URL of the attached image/video asset (legacy field \u2014 media_file_url is the canonical field)"
    },
    "media_file_url": {
      "type": "string",
      "description": "Direct URL of the attached image/video asset (upload, generated image, or Gallery image URL). The canonical media field."
    },
    "media_clip_id": {
      "type": "string",
      "description": "ID of the ClipAsset record when media comes from a clip. The canonical clip reference field."
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "none"
      ],
      "default": "none",
      "description": "Type of media attached"
    },
    "gallery_image_id": {
      "type": "string",
      "description": "ID of the GalleryImage record when media comes from the gallery"
    },
    "clip_asset_id": {
      "type": "string",
      "description": "Legacy clip reference \u2014 read-only support. media_clip_id is the canonical field."
    },
    "crop_status": {
      "type": "string",
      "enum": [
        "none",
        "needs_crop",
        "processing",
        "done",
        "failed"
      ],
      "default": "none",
      "description": "Cropping/canvas processing state"
    },
    "needs_crop": {
      "type": "boolean",
      "default": false,
      "description": "Whether this post's media still needs a final crop before publishing"
    },
    "first_comment": {
      "type": "string",
      "description": "Optional first comment to post immediately after the main post (used for extra hashtags or engagement bait)",
      "maxLength": 2000
    },
    "instagram_first_comment": {
      "type": "string",
      "maxLength": 2000,
      "description": "Instagram-specific first comment text, posted right after the main IG media."
    },
    "facebook_first_comment": {
      "type": "string",
      "maxLength": 2000,
      "description": "Facebook-specific first comment text (manual paste required \u2014 no pages_manage_engagement scope)."
    },
    "instagram_publish_status": {
      "type": "string",
      "enum": [
        "Not Selected",
        "Pending",
        "Publishing",
        "Published",
        "Failed",
        "Connection Required",
        "Permission Required"
      ],
      "default": "Not Selected",
      "description": "Per-platform Instagram publish state"
    },
    "instagram_post_url": {
      "type": "string",
      "description": "Instagram media ID or permalink after publishing"
    },
    "instagram_publish_error": {
      "type": "string",
      "description": "Error message if Instagram publishing failed"
    },
    "instagram_comment_status": {
      "type": "string",
      "description": "Outcome of the Instagram first-comment attempt (Posted, Failed, Not Needed, Manual Required)"
    },
    "instagram_comment_error": {
      "type": "string",
      "description": "Error message if the Instagram first comment failed"
    },
    "facebook_publish_status": {
      "type": "string",
      "enum": [
        "Not Selected",
        "Pending",
        "Publishing",
        "Published",
        "Failed",
        "Connection Required",
        "Permission Required"
      ],
      "default": "Not Selected",
      "description": "Per-platform Facebook publish state"
    },
    "facebook_post_url": {
      "type": "string",
      "description": "Facebook post ID or permalink after publishing"
    },
    "facebook_publish_error": {
      "type": "string",
      "description": "Error message if Facebook publishing failed"
    },
    "facebook_comment_status": {
      "type": "string",
      "description": "Outcome of the Facebook first-comment attempt (Manual Required, Not Needed)"
    },
    "template_id": {
      "type": "string",
      "description": "ID of the VideoTemplate used for video posts"
    },
    "slot_values": {
      "type": "object",
      "description": "Key-value map of template slot fills (slot_name \u2192 value)"
    },
    "video_brief": {
      "type": "string",
      "description": "Human-readable CapCut assembly checklist derived from the template + slot values",
      "maxLength": 4000
    },
    "original_ai_caption": {
      "type": "string",
      "description": "The caption as originally generated by the AI (before any manual edits)"
    },
    "facebook_post_id": {
      "type": "string",
      "description": "Facebook Graph API post ID after publishing (legacy field)"
    },
    "instagram_media_id": {
      "type": "string",
      "description": "Instagram media ID after publishing (legacy field)"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the post was published (legacy field)"
    },
    "publish_error": {
      "type": "string",
      "description": "Error message if publishing failed"
    },
    "create_post_step": {
      "type": "number",
      "description": "Current step in the Create Post wizard (0 = subject, 1 = media, 2 = copy, 3 = review)"
    },
    "create_post_state": {
      "type": "object",
      "description": "Wizard-only state for the Create Post flow (portfolioItemId, campaignId, goal, customGoal, instruction, platformIds, link, copyReady, reviewRecommended, maxStep)"
    },
    "requested_aspect_ratio": {
      "type": "string",
      "description": "Aspect ratio requested in the Create Post wizard (4:5, 1:1, 9:16)"
    },
    "manual_metrics": {
      "type": "object",
      "description": "Manually entered performance metrics (likes, comments, shares, saves, reach, impressions)",
      "properties": {
        "likes": {
          "type": "number"
        },
        "comments": {
          "type": "number"
        },
        "shares": {
          "type": "number"
        },
        "saves": {
          "type": "number"
        },
        "reach": {
          "type": "number"
        },
        "impressions": {
          "type": "number"
        }
      }
    },
    "visual_direction": {
      "type": "object",
      "description": "Structured visual direction for image generation (visual_type, creative_concept, subject, setting, composition, camera_angle, framing, lighting, mood, color_direction, movement, text_overlay, typography_direction, platform, format, aspect_ratio, reference_assets, elements_to_preserve, elements_to_avoid, reason_for_match)"
    },
    "reference_asset_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of reference assets (approved screenshots, logos, product shots) passed to image generation"
    },
    "variation_of": {
      "type": "string",
      "description": "ID of the earlier post this is a regenerated variation of"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes visible only to admin",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}