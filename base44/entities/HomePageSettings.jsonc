{
  "name": "HomePageSettings",
  "type": "object",
  "properties": {
    "hero_background_image": {
      "type": "string",
      "description": "Hero background image URL"
    },
    "hero_artist_image": {
      "type": "string",
      "description": "Studio / profile image URL for hero"
    },
    "hero_overlay_image": {
      "type": "string",
      "description": "Optional decorative overlay graphic URL"
    },
    "hero_title": {
      "type": "string",
      "description": "Hero heading text",
      "default": "iRoxanne Studio"
    },
    "hero_tagline": {
      "type": "string",
      "description": "Hero tagline / subheading"
    },
    "hero_primary_button_text": {
      "type": "string",
      "description": "Primary CTA button label"
    },
    "hero_primary_button_url": {
      "type": "string",
      "description": "Primary CTA button URL or path"
    },
    "hero_secondary_button_text": {
      "type": "string",
      "description": "Secondary CTA button label"
    },
    "hero_secondary_button_url": {
      "type": "string",
      "description": "Secondary CTA button URL or path"
    },
    "featured_release_id": {
      "type": "string",
      "description": "ID of PortfolioItem to feature as the homepage project override. Field name kept for backward compatibility with stored settings."
    },
    "homepage_social_share_image": {
      "type": "string",
      "description": "OG image for homepage sharing"
    },
    "background_video_url": {
      "type": "string",
      "description": "YouTube or external video URL for background"
    },
    "background_video_file": {
      "type": "string",
      "description": "Uploaded MP4 video file for background"
    },
    "enable_background_video": {
      "type": "boolean",
      "default": false,
      "description": "Show video in hero background"
    },
    "hero_layout_style": {
      "type": "string",
      "enum": [
        "centered",
        "artist_left",
        "artist_right",
        "cinematic",
        "album_cover",
        "video_bg"
      ],
      "default": "centered",
      "description": "Hero layout style"
    },
    "hero_glow_intensity": {
      "type": "number",
      "default": 10,
      "description": "Blue glow intensity (1\u201320)"
    },
    "hero_overlay_opacity": {
      "type": "number",
      "default": 40,
      "description": "Background overlay opacity (0\u2013100)"
    },
    "hero_text_alignment": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "center",
      "description": "Hero text alignment"
    },
    "show_featured_release": {
      "type": "boolean",
      "default": true,
      "description": "Show the featured project banner on the homepage. Field name kept for backward compatibility."
    },
    "show_video_preview": {
      "type": "boolean",
      "default": true,
      "description": "Show the latest work section"
    },
    "show_newsletter": {
      "type": "boolean",
      "default": true
    },
    "show_gallery_preview": {
      "type": "boolean",
      "default": false,
      "description": "Show a portfolio preview section"
    },
    "description": {
      "type": "string",
      "description": "Optional description for these homepage settings",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}