{
  "name": "StripeCheckout",
  "type": "object",
  "description": "One Stripe Checkout session bound to a specific invoice charge. Mirrors SquareCheckout: the binding record is what proves an incoming webhook belongs to this invoice, and it tracks abandoned, expired and declined outcomes that never produce a Payment.",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "Invoice this checkout session was created for"
    },
    "session_id": {
      "type": "string",
      "description": "Stripe Checkout Session ID (cs_...)"
    },
    "payment_intent": {
      "type": "string",
      "description": "Stripe PaymentIntent ID (pi_...), once Stripe assigns one"
    },
    "kind": {
      "type": "string",
      "enum": [
        "deposit",
        "milestone",
        "balance"
      ],
      "description": "Which charge on the invoice this session covers"
    },
    "milestone_index": {
      "type": "number",
      "description": "Index into Invoice.milestones when kind is milestone"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "expected_amount_cents": {
      "type": "number",
      "description": "Amount this session was created for, in cents. A webhook whose amount differs is not credited."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed",
        "expired",
        "cancelled"
      ],
      "default": "pending",
      "description": "pending = client sent to Stripe; processing = BNPL awaiting provider confirmation; paid = credited; failed = declined; expired = session timed out unpaid"
    },
    "payment_method_type": {
      "type": "string",
      "description": "What the client actually paid with, as reported by Stripe: card, affirm, afterpay_clearpay, klarna, link"
    },
    "last_error": {
      "type": "string",
      "description": "Decline reason or webhook error, for admin review"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "invoice_id",
    "session_id",
    "kind",
    "expected_amount_cents"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}