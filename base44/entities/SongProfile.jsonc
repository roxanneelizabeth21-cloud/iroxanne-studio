{
  "name": "SongProfile",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Song title (the knowledge base key \u2014 used to match a Release or stand alone)"
    },
    "song_id": {
      "type": "string",
      "description": "Optional reference to the Release (song/album) this profile describes"
    },
    "lyrics": {
      "type": "string",
      "description": "Full lyrics with section labels like [Verse 1], [Chorus]"
    },
    "audio_file": {
      "type": "string",
      "description": "Uploaded audio file URL for this song (mp3/m4a/wav)"
    },
    "song_story": {
      "type": "string",
      "description": "What the song is about and why it was written"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Theme tags, e.g. Faith, Love, Resilience, Island Life, Family, Joy"
    },
    "key_lines": {
      "type": "string",
      "description": "The most quotable / hook-worthy lyric lines, one per line"
    },
    "chorus_summary": {
      "type": "string",
      "description": "The chorus message in one sentence"
    },
    "streaming_links": {
      "type": "string",
      "description": "Streaming platform links the AI can reference for this song"
    },
    "release_status": {
      "type": "string",
      "enum": [
        "Unreleased",
        "Upcoming",
        "Released"
      ],
      "default": "Unreleased",
      "description": "Where this song is in its release lifecycle"
    },
    "release_date": {
      "type": "string",
      "format": "date",
      "description": "Planned release date (optional)"
    },
    "evergreen_on": {
      "type": "boolean",
      "default": true,
      "description": "Whether the auto-generation evergreen rotation should keep promoting this song"
    },
    "description": {
      "type": "string",
      "description": "Optional description for this song profile",
      "maxLength": 1000
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}