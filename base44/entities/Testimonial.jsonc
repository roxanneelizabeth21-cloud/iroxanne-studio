{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description for this testimonial",
      "maxLength": 1000
    },
    "client_name": {
      "type": "string",
      "description": "Client name. Only shown publicly when approved_for_use is true and client_anonymous is false."
    },
    "client_anonymous": {
      "type": "boolean",
      "default": false,
      "description": "When true, generated/public content references the client generically (e.g. 'a recent client') instead of by name."
    },
    "quote": {
      "type": "string",
      "description": "The testimonial quote"
    },
    "portfolio_item_id": {
      "type": "string",
      "description": "Optional PortfolioItem this testimonial is about"
    },
    "approved_for_use": {
      "type": "boolean",
      "default": false,
      "description": "Whether this testimonial may be used in generated/public content. Generated posts must never quote an unapproved testimonial."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "When the testimonial was given"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower shows first)"
    },
    "consent_to_publish": {
      "type": "boolean",
      "default": false
    },
    "featured_homepage": {
      "type": "boolean",
      "default": false
    },
    "permission_notes": {
      "type": "string",
      "maxLength": 2000
    },
    "access_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_pending": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "quote"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}